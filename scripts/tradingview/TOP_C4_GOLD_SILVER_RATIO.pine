//@version=6
// COMPILED OK on the TradingView server (2026-10-14); behaviour not yet compared trade by trade with the lab engine. Research only; no order-routing alerts.
// Replica of one chart leg, NOT the combined GLD/SLV portfolio equity curve.
// Apply separately to GLD and SLV daily charts; Python rotates a shared cash account.
// Execution reference: https://www.tradingview.com/pine-script-docs/concepts/strategies/
strategy("TOP_C4_GOLD_SILVER_RATIO", overlay=false, pyramiding=0, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.025, process_orders_on_close=false, calc_on_every_tick=false, margin_long=100)
lookback = input.int(60, "Lookback", minval=2)
threshold = input.float(2.0, "Z threshold", minval=0.1)
goldSymbol = input.symbol("AMEX:GLD", "Gold ETF")
silverSymbol = input.symbol("AMEX:SLV", "Silver ETF")
if not timeframe.isdaily or timeframe.multiplier != 1
    runtime.error("Use a 1D chart")
if syminfo.ticker != "GLD" and syminfo.ticker != "SLV"
    runtime.error("Use GLD or SLV; this strategy tests only the chart leg")
// Same-timeframe confirmed daily closes; no future values are requested.
gold = request.security(goldSymbol, "1D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
silver = request.security(silverSymbol, "1D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
ratio = gold / silver
dispersion = ta.stdev(ratio, lookback, true)
z = dispersion > 0 ? (ratio - ta.sma(ratio, lookback)) / dispersion : na
// Extreme positive ratio selects silver; extreme negative ratio selects gold.
silverSelected = not na(z) and z >= threshold
goldSelected = not na(z) and z <= -threshold
selected = syminfo.ticker == "SLV" ? silverSelected : goldSelected
// Market orders generated on the close fill on the next bar open.
if barstate.isconfirmed
    if selected and strategy.position_size == 0
        strategy.entry("Metal", strategy.long)
    if not selected and strategy.position_size > 0
        strategy.close("Metal")
plot(z, "Ratio z-score", color=color.blue)
hline(threshold, "Silver threshold", color=color.gray)
hline(-threshold, "Gold threshold", color=color.orange)
hline(0, "Mean", color=color.new(color.gray, 70))
plotshape(silverSelected, "Select silver", shape.triangleup, location.bottom, color=color.gray, size=size.tiny)
plotshape(goldSelected, "Select gold", shape.triangleup, location.bottom, color=color.orange, size=size.tiny)
var table info = table.new(position.top_right, 1, 3)
if barstate.islast
    table.cell(info, 0, 0, "TOP_C4_GOLD_SILVER_RATIO")
    table.cell(info, 0, 1, "1D | next open | 0.025% per side")
    table.cell(info, 0, 2, "one leg | research only")
