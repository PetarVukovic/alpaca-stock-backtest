//@version=6
// C31: research transfer only. No alert() and no brokerage integration.
// BASE fee 0.05% per side; stress copy changes only declaration + anchor fee.
strategy("C31 C13C cross-market research", overlay=true, initial_capital=10000,
 default_qty_type=strategy.percent_of_equity, default_qty_value=90, pyramiding=0,
 commission_type=strategy.commission.percent, commission_value=0.05, slippage=1,
 calc_on_order_fills=true, calc_on_every_tick=false, process_orders_on_close=false,
 margin_long=100, margin_short=100)
startTime = input.time(timestamp("01 Jan 2021 00:00 +0000"), "Start UTC")
endTime = input.time(timestamp("09 Oct 2026 00:00 +0000"), "End completed bars UTC")
feeFraction = 0.0005
ma = ta.sma(close, 200)
ret5 = close / close[5] - 1
varip float peak = na
varip float stopLevel = na
varip int seenEntries = 0
varip int seenClosed = 0
varip float cutoffEquity = 10000
varip float equityPeak = 10000
varip float closeDrawdown = 0
varip int cutoffTime = na
varip int eligibleSignals = 0
varip int dailyBars = 0
varip int lastCounted = na
varip bool ended = false
varip array<float> years = array.new_float(6, na)
newEntry = strategy.opentrades + strategy.closedtrades > seenEntries
newExit = strategy.closedtrades > seenClosed
window = time >= startTime and time_close <= endTime
if newEntry
    seenEntries := strategy.opentrades + strategy.closedtrades
    peak := (strategy.position_avg_price - syminfo.mintick) * (1 + feeFraction) + syminfo.mintick
    stopLevel := math.round_to_mintick(peak * 0.90)
    strategy.exit("protect", "C13C", stop=stopLevel)
else if newExit
    seenClosed := strategy.closedtrades
    peak := na
    stopLevel := na
else if barstate.isconfirmed and not ended
    if window
        if strategy.position_size > 0
            peak := math.max(peak, high)
            stopLevel := math.max(stopLevel, math.round_to_mintick(peak * 0.90))
            strategy.exit("protect", "C13C", stop=stopLevel)
        canEnter = time_close <= endTime - 86400000 and timeframe.isdaily and timeframe.multiplier == 1
        signal = close > ma and ret5 <= -0.05
        if na(lastCounted) or bar_index != lastCounted
            eligibleSignals += signal ? 1 : 0
            dailyBars += 1
            lastCounted := bar_index
        if strategy.position_size == 0 and canEnter and signal
            strategy.entry("C13C", strategy.long)
        cutoffEquity := strategy.equity
        equityPeak := math.max(equityPeak, cutoffEquity)
        closeDrawdown := math.max(closeDrawdown, 100 * (1 - cutoffEquity / equityPeak))
        cutoffTime := time_close
        yi = year(time_close - 1, "UTC") - 2021
        if yi >= 0 and yi < 6
            array.set(years, yi, cutoffEquity)
        if time_close > endTime - 86400000
            strategy.cancel_all()
            ended := true
    else if time_close > endTime
        strategy.cancel_all()
        ended := true
plot(ma, "SMA200", color=color.orange)
plot(strategy.position_size > 0 ? stopLevel : na, "Next session stop", color=color.red, style=plot.style_linebr)
plot(cutoffEquity, "Completed equity", display=display.data_window)
plot(closeDrawdown, "Close drawdown percent", display=display.data_window)
var table info = table.new(position.top_right, 1, 1)
var table trades = table.new(position.bottom_right, 1, 201)
meta = "C31|" + syminfo.tickerid + "|" + syminfo.currency + "|" + str.tostring(syminfo.pointvalue) + "|" + str.tostring(syminfo.mintick) + "\n"
meta += "equity|" + str.tostring(cutoffEquity, "#.########") + "|dd_close_pct|" + str.tostring(closeDrawdown, "#.########") + "|cutoff_ms|" + str.tostring(cutoffTime) + "\n"
meta += "bars|" + str.tostring(dailyBars) + "|signals|" + str.tostring(eligibleSignals) + "|closed|" + str.tostring(strategy.closedtrades) + "|open|" + str.tostring(strategy.opentrades) + "\n"
meta += "quote_account_10000|allocation_90pct|margin_100pct|funding_swap_EXCLUDED\n"
for y = 0 to 5
    meta += str.tostring(2021 + y) + "|" + str.tostring(array.get(years, y), "#.########") + "\n"
table.cell(info, 0, 0, meta, bgcolor=color.new(color.orange, 15), text_color=color.black, text_size=size.small)
table.cell(trades, 0, 0, "trade|entry_ms|exit_ms|entry_price|exit_price|qty|pnl|commission", text_size=size.tiny)
if barstate.islastconfirmedhistory or barstate.islast
    if strategy.closedtrades > 0
        for i = 0 to math.min(strategy.closedtrades - 1, 198)
            row = str.tostring(i) + "|" + str.tostring(strategy.closedtrades.entry_time(i)) + "|" + str.tostring(strategy.closedtrades.exit_time(i)) + "|" + str.tostring(strategy.closedtrades.entry_price(i), "#.########") + "|" + str.tostring(strategy.closedtrades.exit_price(i), "#.########") + "|" + str.tostring(strategy.closedtrades.size(i), "#.########") + "|" + str.tostring(strategy.closedtrades.profit(i), "#.########") + "|" + str.tostring(strategy.closedtrades.commission(i), "#.########")
            table.cell(trades, 0, i + 1, row, text_size=size.tiny)
    if strategy.opentrades > 0
        i = strategy.opentrades - 1
        row = "OPEN|" + str.tostring(strategy.opentrades.entry_time(i)) + "|" + str.tostring(strategy.opentrades.entry_price(i), "#.########") + "|" + str.tostring(strategy.opentrades.size(i), "#.########")
        table.cell(trades, 0, 200, row, text_size=size.tiny)
