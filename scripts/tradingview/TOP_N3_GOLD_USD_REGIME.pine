// COMPILED OK on the TradingView server (2026-10-14); behaviour not yet compared trade by trade with the lab engine.
// ID: TOP_N3_GOLD_USD_REGIME (research only, not a lab Critic PASS, not a trade recommendation; never sends orders)
// Rules (daily chart; apply to GLD or SLV):
//  1. Regime ON if UUP close < SMA(trend) OR TLT close > SMA(trend).
//  2. A metal qualifies if its close > its own SMA(trend).
//  3. Hold the qualifying metal with the higher rs_lookback-day return (GLD vs SLV), else cash.
//  4. Decide at the close, fill at the next open (process_orders_on_close=false). Long-only, no leverage.
//  Cost: 2.5 bps per side (5 bps round trip) -> commission_value=0.025 percent per order.
//@version=6
strategy("TOP_N3_GOLD_USD_REGIME", overlay=true, initial_capital=100000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.025,
     process_orders_on_close=false, pyramiding=0)

trendLen = input.int(100, "Trend SMA length", minval=2)
rsLen    = input.int(63, "Relative strength lookback", minval=1)

// Signal-only series (daily close, no look-ahead from higher timeframe)
uup = request.security("UUP", "D", close, lookahead=barmerge.lookahead_off)
tlt = request.security("TLT", "D", close, lookahead=barmerge.lookahead_off)
gld = request.security("GLD", "D", close, lookahead=barmerge.lookahead_off)
slv = request.security("SLV", "D", close, lookahead=barmerge.lookahead_off)

smaUup = ta.sma(uup, trendLen)
smaTlt = ta.sma(tlt, trendLen)
smaGld = ta.sma(gld, trendLen)
smaSlv = ta.sma(slv, trendLen)

dollarDown = uup < smaUup
bondsUp    = tlt > smaTlt
regimeOn   = dollarDown or bondsUp

gldQ = gld > smaGld
slvQ = slv > smaSlv
gldMom = gld / gld[rsLen] - 1
slvMom = slv / slv[rsLen] - 1
gldScore = (regimeOn and gldQ) ? gldMom : na
slvScore = (regimeOn and slvQ) ? slvMom : na

pickGld = not na(gldScore) and (na(slvScore) or gldScore >= slvScore)
pickSlv = not na(slvScore) and not pickGld

// Which metal is the chart symbol?
isGld = syminfo.ticker == "GLD"
isSlv = syminfo.ticker == "SLV"
wantLong = (isGld and pickGld) or (isSlv and pickSlv)

if wantLong and strategy.position_size == 0
    strategy.entry("Long", strategy.long)   // fills at next bar open
if not wantLong and strategy.position_size > 0
    strategy.close("Long")                  // fills at next bar open

bgcolor(regimeOn ? color.new(color.green, 92) : color.new(color.red, 92))
plotshape(wantLong and not wantLong[1], "Signal on", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(not wantLong and wantLong[1], "Signal off", shape.triangledown, location.abovebar, color.red, size=size.small)
plot(ta.sma(close, trendLen), "Metal SMA", color.orange)

var table info = table.new(position.top_right, 2, 5, border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "ID", text_color=color.white, bgcolor=color.gray)
    table.cell(info, 1, 0, "TOP_N3_GOLD_USD_REGIME", text_color=color.white, bgcolor=color.gray)
    table.cell(info, 0, 1, "Dollar down (UUP<SMA)")
    table.cell(info, 1, 1, str.tostring(dollarDown))
    table.cell(info, 0, 2, "Bonds up (TLT>SMA)")
    table.cell(info, 1, 2, str.tostring(bondsUp))
    table.cell(info, 0, 3, "GLD / SLV score")
    table.cell(info, 1, 3, str.tostring(gldScore, "#.##") + " / " + str.tostring(slvScore, "#.##"))
    table.cell(info, 0, 4, "Chart symbol holds")
    table.cell(info, 1, 4, str.tostring(wantLong))
