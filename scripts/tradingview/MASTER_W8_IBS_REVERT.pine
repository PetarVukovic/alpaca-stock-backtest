//@version=6
// MASTER_W8_IBS_REVERT  (lab id: SWING_W8_IBS_REVERT)  -  research only, not advice, no orders are ever sent.
// RULE (frozen, do not tune):
//   IBS ("internal bar strength") = (close - low) / (high - low): 0 means the day closed at its low, 1 at its high.
//   1. Entry signal at the CLOSE of a daily bar: IBS < 0.2 (weak close) AND close > SMA200 (uptrend).
//      One position at a time, long only. The buy fills at the NEXT bar's open.
//   2. Exit signal at a close: IBS > 0.8, or the position is 5 bars old (the fill bar counts as bar 1).
//      The sale fills at the next open. There is no price stop in this rule.
//   3. A day with high == low has no IBS (no entry and no IBS exit; the time exit still works).
// COSTS: 0.025 percent per side (2.5 bps). No slippage, FX, tax, minimum fee.
// ALERTS: TradingView ignores alertcondition() inside strategies, so information-only alert() calls are used.
//   When you create an alert choose 'Any alert() function call'. Never pick order-fill alerts or webhooks.
// INFO TABLE: in a strategy the table is refreshed only on a confirmed (closed) bar.
// VERSION: 2026-10-14 v1
// COMPILED OK 2026-10-14; behaviour not yet compared trade by trade with the Python engine
strategy("MASTER_W8_IBS_REVERT", overlay=true, initial_capital=1000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.025,
     process_orders_on_close=false, calc_on_every_tick=false, pyramiding=0)

ibsIn   = input.float(0.2, "Ulaz: IBS ispod", minval=0.0, maxval=1.0, step=0.05)
ibsOut  = input.float(0.8, "Izlaz: IBS iznad", minval=0.0, maxval=1.0, step=0.05)
smaLen  = input.int(200, "Prosjek cijene: broj dana (SMA)", minval=1)
maxBars = input.int(5, "Izlaz: najviše dana držanja", minval=1)
startT  = input.time(timestamp("2023-01-01T00:00:00"), "Trguj od (AI era; samo prozor testa)")

rng    = high - low
ibs    = rng > 0 ? (close - low) / rng : na
sma    = ta.sma(close, smaLen)
inWin  = time >= startT
flat   = strategy.position_size == 0
signal = barstate.isconfirmed and inWin and flat and not na(ibs) and not na(sma) and ibs < ibsIn and close > sma
if signal
    strategy.entry("W8", strategy.long)

barsHeld = strategy.position_size > 0 ? bar_index - strategy.opentrades.entry_bar_index(0) + 1 : 0
exitSig = strategy.position_size > 0 and barstate.isconfirmed and (barsHeld >= maxBars or (not na(ibs) and ibs > ibsOut))
if exitSig
    strategy.close("W8", comment="W8 izlaz")

plot(sma, "SMA200", color=color.new(color.blue, 0))
plot(ibs, "IBS (0 do 1)", display=display.data_window)
plotshape(signal, "Signal za kupnju (iduće otvaranje)", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(exitSig, "Signal za prodaju (iduće otvaranje)", shape.triangledown, location.abovebar, color.orange, size=size.small)
var tbl = table.new(position.top_right, 1, 3)
if barstate.islast
    table.cell(tbl, 0, 0, "ID: SWING_W8_IBS_REVERT", text_color=color.white, bgcolor=color.new(color.gray, 20))
    table.cell(tbl, 0, 1, "Istraživanje, nije savjet. Nema naloga.", text_color=color.white, bgcolor=color.new(color.gray, 20))
    table.cell(tbl, 0, 2, "IBS danas: " + (na(ibs) ? "n/a" : str.tostring(ibs, "#.00")), text_color=color.white, bgcolor=color.new(color.gray, 20))

if signal
    alert("W8_IBS_REVERT: dnevno zatvaranje ispunjava pravilo ulaza. Samo informacija.", alert.freq_once_per_bar_close)
if exitSig
    alert("W8_IBS_REVERT: dnevno zatvaranje ispunjava pravilo izlaza. Samo informacija.", alert.freq_once_per_bar_close)
