// TOP_N1_SEMI_LEADLAG - Pine Script v6 replica of the frozen lab rule (research only, no orders).
// COMPILED OK on the TradingView server (2026-10-14); behaviour not yet compared trade by trade with the lab engine. Apply on a DAILY chart of MU, WDC or STX (one chart per memory name).
// Lab: 1/3 of capital per eligible memory name; here each chart trades its own name with 33.3% of equity.
// Lab cost: 2.5 bps per side -> commission_value = 0.025 (percent). Fills at the NEXT bar open.
//@version=6
strategy("TOP_N1_SEMI_LEADLAG", overlay=true, initial_capital=100000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=33.3333,
     commission_type=strategy.commission.percent, commission_value=0.025,
     process_orders_on_close=false, calc_on_every_tick=false)

// Inputs = frozen PARAMS defaults
leaderTrend = input.int(100, "leader_trend (SMA bars)", minval=1)
stockTrend  = input.int(50,  "stock_trend (SMA bars)",  minval=1)
minLeaders  = input.int(3,   "min_leaders (of 4)",      minval=1, maxval=4)

// Rule 1: a leader is "in uptrend" if its close is above its own SMA(leader_trend).
leaderUp(sym) =>
    c = request.security(sym, "D", close, lookahead=barmerge.lookahead_off)
    m = request.security(sym, "D", ta.sma(close, leaderTrend), lookahead=barmerge.lookahead_off)
    c > m ? 1 : 0

upCount = leaderUp("AMAT") + leaderUp("LRCX") + leaderUp("KLAC") + leaderUp("SMH")

// Rule 2: the basket is confirmed when at least min_leaders leaders are in uptrend.
confirmed = upCount >= minLeaders

// Rule 3: the stock is eligible if confirmed AND close above its own SMA(stock_trend).
stockMa  = ta.sma(close, stockTrend)
eligible = confirmed and close > stockMa

// Rule 4/5: decide at the close, fill at next open (strategy default). Long-only, no hysteresis.
if eligible and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if not eligible and strategy.position_size > 0
    strategy.close("Long")

plot(stockMa, "Stock trend", color=color.orange)
bgcolor(confirmed ? color.new(color.green, 90) : na, title="Leaders confirmed")
plotshape(eligible and not eligible[1], "Eligible", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(not eligible and eligible[1], "Not eligible", shape.triangledown, location.abovebar, color.red, size=size.small)

var table info = table.new(position.top_right, 1, 3, border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "TOP_N1_SEMI_LEADLAG", text_color=color.white, bgcolor=color.new(color.blue, 30))
    table.cell(info, 0, 1, "Leaders up: " + str.tostring(upCount) + "/4", text_color=color.white, bgcolor=color.new(color.gray, 40))
    table.cell(info, 0, 2, "Research only, not a Critic PASS", text_color=color.white, bgcolor=color.new(color.gray, 40))
