//@version=6
// MASTER_W2_MOM_BREAK_20  (lab id: SWING_W2_MOM_BREAK_20)  -  research only, not advice, no orders are ever sent.
// RULE (frozen, do not tune):
//   1. Entry signal at the CLOSE of a daily bar: the close is the highest close of the last 20 days (today
//      included), the 60-day return is above 0, and close > SMA50. One position at a time, long only.
//   2. The buy fills at the NEXT bar's open.
//   3. Exit signal at a close: close < lowest low of the 10 bars BEFORE today, or the position is 15 bars old
//      (the fill bar counts as bar 1). The sale fills at the next open.
//   4. Protective stop 8 percent under the real entry price (a gap below it fills at the open).
// COSTS: 0.025 percent per side (2.5 bps). No slippage, FX, tax, minimum fee.
// KNOWN DIFFERENCE vs the Python engine: the 8 percent stop is not active on the entry bar itself
//   (Pine cannot know the fill price in advance); Python checks it on the entry bar too.
// ALERTS: TradingView ignores alertcondition() inside strategies, so information-only alert() calls are used.
//   When you create an alert choose 'Any alert() function call'. Never pick order-fill alerts or webhooks.
// INFO TABLE: in a strategy the table is refreshed only on a confirmed (closed) bar.
// VERSION: 2026-10-14 v1
// COMPILED OK 2026-10-14; behaviour not yet compared trade by trade with the Python engine
strategy("MASTER_W2_MOM_BREAK_20", overlay=true, initial_capital=1000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.025,
     process_orders_on_close=false, calc_on_every_tick=false, pyramiding=0)

highN   = input.int(20, "Proboj: najviše zatvaranje zadnjih N dana", minval=1)
retN    = input.int(60, "Zamah: povrat u zadnjih N dana mora biti > 0", minval=1)
smaLen  = input.int(50, "Prosjek cijene: broj dana (SMA)", minval=1)
exitN   = input.int(10, "Izlaz: zatvaranje ispod najnižeg od prethodnih N dana", minval=1)
maxBars = input.int(15, "Izlaz: najviše dana držanja", minval=1)
stopPct = input.float(8.0, "Zaštitni stop: % ispod ulazne cijene", minval=0.5, step=0.5)
startT  = input.time(timestamp("2023-01-01T00:00:00"), "Trguj od (AI era; samo prozor testa)")

sma      = ta.sma(close, smaLen)
isHigh   = close >= ta.highest(close, highN)
retPos   = close / close[retN] - 1 > 0
priorLow = ta.lowest(low, exitN)[1]
inWin    = time >= startT
flat     = strategy.position_size == 0
signal   = barstate.isconfirmed and inWin and flat and isHigh and retPos and close > sma

if signal
    strategy.entry("W2", strategy.long)

// exit signal is evaluated only while the position is open (fill bar = bar 1)
barsHeld = strategy.position_size > 0 ? bar_index - strategy.opentrades.entry_bar_index(0) + 1 : 0
exitSig = strategy.position_size > 0 and barstate.isconfirmed and (barsHeld >= maxBars or close < priorLow)
if strategy.position_size > 0
    strategy.exit("W2 stop", "W2", stop=math.round_to_mintick(strategy.position_avg_price * (1 - stopPct / 100)))
if exitSig
    strategy.close("W2", comment="W2 izlaz")

plot(sma, "SMA50", color=color.new(color.blue, 0))
plot(strategy.position_size > 0 ? strategy.position_avg_price * (1 - stopPct / 100) : na, "Zaštitni stop", color=color.red, style=plot.style_linebr)
plotshape(signal, "Signal za kupnju (iduće otvaranje)", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(exitSig, "Signal za prodaju (iduće otvaranje)", shape.triangledown, location.abovebar, color.orange, size=size.small)
var tbl = table.new(position.top_right, 1, 3)
if barstate.islast
    table.cell(tbl, 0, 0, "ID: SWING_W2_MOM_BREAK_20", text_color=color.white, bgcolor=color.new(color.gray, 20))
    table.cell(tbl, 0, 1, "Istraživanje, nije savjet. Nema naloga.", text_color=color.white, bgcolor=color.new(color.gray, 20))
    table.cell(tbl, 0, 2, strategy.position_size > 0 ? "U poziciji, dan " + str.tostring(barsHeld) + " od " + str.tostring(maxBars) : "Izvan pozicije", text_color=color.white, bgcolor=color.new(color.gray, 20))

if signal
    alert("W2_MOM_BREAK_20: dnevno zatvaranje ispunjava pravilo ulaza. Samo informacija.", alert.freq_once_per_bar_close)
if exitSig
    alert("W2_MOM_BREAK_20: dnevno zatvaranje ispunjava pravilo izlaza. Samo informacija.", alert.freq_once_per_bar_close)
