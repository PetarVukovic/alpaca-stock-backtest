//@version=6
// C13A replica (frozen rule, do not tune): trend filter + 5-day dip.
// Entry: close > SMA200 and 5-day change <= -5 %, filled at next open.
// Exit: stop -8 % from entry, or after 10 bars (entry bar = bar 1; the sell fills at the NEXT open, like lab/engine.py). One position at a time.
// Costs: 5 bps round trip (0.025 % per side) + 1 tick slippage.
// Everything below the "visuals" marker only draws; it never changes a trade.
// On-chart texts are Croatian on purpose (the user is learning from them); code comments stay English.
strategy("C13A replica", overlay=true, initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.025,
     slippage=1, pyramiding=0, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

startTime   = input.time(timestamp("2024-01-01T00:00:00"), "Trguj od (samo prozor, pravilo se ne mijenja)", tooltip="Datum od kojeg skripta smije ulaziti u trgovine. Mijenja samo prozor testa, ne pravilo.")
endTime     = input.time(timestamp("2030-01-01T00:00:00"), "Bez novih ulaza nakon (samo prozor)", tooltip="Nakon ovog datuma nema novih ulaza. Tako gledaš jedno razdoblje, npr. 2022.")
showRegime  = input.bool(true, "Prikaži pozadinu trenda (zeleno iznad SMA 200, crveno ispod)")
showDips    = input.bool(true, "Prikaži padove (zeleni krug = signal, sivi križ = preskočeno)")
showTrades  = input.bool(true, "Prikaži okvir trgovine, stop liniju i rezultat")
showSignals = input.bool(true, "Prikaži poruke: SIGNAL, ULAZ, IZLAZ")
showLegend  = input.bool(false, "Prikaži legendu oznaka (gore desno)")
showStatus  = input.bool(false, "Prikaži stanje na zadnjoj svijeći (dolje desno)")
showGlossary = input.bool(false, "Prikaži pojmovnik (dolje lijevo)", tooltip="Kratko objašnjenje pojmova koje vidiš na grafu.")
showDayNo   = input.bool(false, "Piši broj dana u poziciji ispod svijeće")
accountEur  = input.float(600, "Veličina računa u € (samo za tekst poruke, ne mijenja trgovine)", minval=1)
riskPct     = input.float(2.0, "Rizik po trgovini u % računa (samo za tekst poruke)", minval=0.1, maxval=100)

sma200  = ta.sma(close, 200)
chg5    = close / close[5] - 1
trendUp = close > sma200
dip     = chg5 <= -0.05
inWin   = time >= startTime and time <= endTime
signal  = inWin and strategy.position_size == 0 and trendUp and dip

if signal
    strategy.entry("C13A", strategy.long)

if strategy.position_size > 0
    strategy.exit("stop", "C13A", stop = strategy.position_avg_price * 0.92)
    // entry bar has index diff 0 = day 1, so diff 9 is the 10th bar; the close order then fills at the next open
    if bar_index - strategy.opentrades.entry_bar_index(0) >= 9
        strategy.close("C13A", comment = "10 dana")

// ---- alerts: text for the e-mail only, they never change a trade ----
nyDate = str.format_time(time, "dd.MM.yyyy", "America/New_York")
if signal
    alert("C13A SIGNAL: " + syminfo.ticker + " (svijeća " + nyDate + ")" + "\n\n" +
         "Zatvaranje: " + str.tostring(close, "#.##") + " $" + "\n" +
         "Promjena u 5 dana: " + str.tostring(chg5 * 100, "#.##") + " % (uvjet: -5 % ili manje)" + "\n" +
         "SMA200: " + str.tostring(sma200, "#.##") + " $ (zatvaranje je iznad, trend je gore)" + "\n\n" +
         "ŠTO RADIŠ SUTRA:" + "\n" +
         "1. U 15:30 po Zagrebu otvara se burza (14:30 u tjednima 8. do 28. 3. i 25. do 31. 10.). Otvori " + syminfo.ticker + "." + "\n" +
         "2. Ako već držiš poziciju na drugoj dionici, PRESKOČI (pravilo: jedna pozicija odjednom, prioritet MU, WDC, STX)." + "\n" +
         "3. Provjeri da je račun Paper Trading. Ako je gap veći od 5 %, pričekaj 5 minuta i zapiši to u dnevnik." + "\n" +
         "4. Kupi tržišnim nalogom (Market, Buy). VELIČINA za račun od " + str.tostring(accountEur, "#") + " € i rizik " + str.tostring(riskPct, "#.#") + " %: ulog oko " + str.tostring(accountEur * riskPct / 100 / 0.08, "#") + " $ (gubitak na stopu oko " + str.tostring(accountEur * riskPct / 100, "#.#") + " €), to je oko " + str.tostring(accountEur * riskPct / 100 / 0.08 / close, "#.###") + " dionice. Tečaj EUR/USD nije uračunat. Ako je broj manji od 1, treba broker s razlomljenim dionicama." + "\n" +
         "5. ODMAH postavi stop 8 % ispod STVARNE cijene ulaza (okvirno " + str.tostring(close * 0.92, "#.##") + " $ ako otvori blizu zatvaranja)." + "\n" +
         "6. Upiši u dnevnik: ulaz, stop i datum 10. dana. Izlaz: stop, ili prodaja sljedeće jutro nakon 10. dana (dan ulaska je dan 1)." + "\n\n" +
         "Paper trading. Nije savjet za ulaganje.", alert.freq_once_per_bar_close)

if strategy.position_size > 0 and bar_index - strategy.opentrades.entry_bar_index(0) >= 9
    alert("C13A IZLAZ SUTRA: " + syminfo.ticker + " (svijeća " + nyDate + ")" + "\n\n" +
         "Danas je 10. dan u poziciji." + "\n" +
         "SUTRA u 15:30 po Zagrebu: prodaj cijelu poziciju tržišnim nalogom (Market, Sell) i otkaži stop nalog." + "\n" +
         "Upiši izlaz u dnevnik.", alert.freq_once_per_bar_close)

// ---- visuals ----
plot(sma200, "SMA 200 (prosjek 200 dana)", color=color.orange, linewidth=2)
bgcolor(showRegime and not na(sma200) ? (trendUp ? color.new(color.green, 92) : color.new(color.red, 92)) : na)
plotshape(showDips and inWin and dip and trendUp, "Dan signala (pad uz trend gore)", shape.circle, location.belowbar, color.green, size=size.small)
plotshape(showDips and inWin and dip and not trendUp, "Preskočen pad (trend dolje)", shape.xcross, location.belowbar, color.gray, size=size.tiny)

// values shown in the status line and Data Window for the bar under the cursor
plot(chg5 * 100, "Promjena u 5 dana (%)", display=display.status_line + display.data_window)
plot(trendUp ? 1 : 0, "Trend gore (1 = da, 0 = ne)", display=display.status_line + display.data_window)
plot(strategy.position_size > 0 ? bar_index - strategy.opentrades.entry_bar_index(0) + 1 : na, "Dan u poziciji", display=display.status_line + display.data_window)

if showSignals and signal
    label.new(bar_index, low, "SIGNAL\nsutra kupnja", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small,
         tooltip="SIGNAL: cijena je iznad SMA 200 (trend gore) i pala je najmanje 5 % u zadnjih 5 dana. Sutra na otvaranju pravilo kupuje.")

if showSignals and strategy.position_size > 0 and strategy.position_size[1] == 0
    label.new(bar_index, low, "ULAZ\n" + str.tostring(strategy.position_avg_price, "0.00"), style=label.style_label_up, color=color.blue, textcolor=color.white, size=size.small,
         tooltip="ULAZ: kupnja na otvaranju dana nakon signala. Stop je 8 % ispod ulazne cijene: " + str.tostring(strategy.position_avg_price * 0.92, "0.00") + ". Izlaz najkasnije nakon 10 dana.")

if showDayNo and strategy.position_size > 0
    label.new(bar_index, low, str.tostring(bar_index - strategy.opentrades.entry_bar_index(0) + 1), style=label.style_label_up, color=color.new(color.gray, 40), textcolor=color.white, size=size.tiny,
         tooltip="Dan u poziciji (izlaz najkasnije 10. dan).")

if showTrades and strategy.closedtrades > strategy.closedtrades[1]
    idx    = strategy.closedtrades - 1
    eBar   = strategy.closedtrades.entry_bar_index(idx)
    ePrice = strategy.closedtrades.entry_price(idx)
    xPrice = strategy.closedtrades.exit_price(idx)
    ret    = strategy.closedtrades.profit_percent(idx)
    byTime = strategy.closedtrades.exit_comment(idx) == "10 dana"
    why    = byTime ? "istek 10 dana" : "stop −8 %"
    hi = high
    lo = low
    for i = 0 to bar_index - eBar
        hi := math.max(hi, high[i])
        lo := math.min(lo, low[i])
    col = ret > 0 ? color.green : color.red
    box.new(eBar, hi, bar_index, lo, border_color=col, border_style=line.style_dashed, bgcolor=color.new(col, 88),
         text=(ret > 0 ? "DOBITNA" : "GUBITNA") + " trgovina", text_color=col, text_size=size.tiny, text_halign=text.align_left, text_valign=text.align_top)
    line.new(eBar, ePrice * 0.92, bar_index, ePrice * 0.92, color=color.red, width=2)
    line.new(eBar, ePrice, eBar + 3, ePrice, color=color.black, width=2)
    label.new(bar_index, ePrice * 0.92, "stop −8 %\n" + str.tostring(ePrice * 0.92, "0.00"), style=label.style_label_left, color=color.new(color.red, 20), textcolor=color.white, size=size.tiny,
         tooltip="Crvena linija: stop 8 % ispod ulazne cijene. Ako cijena dotakne tu razinu, pravilo odmah izlazi.")
    label.new(bar_index, hi, "IZLAZ: " + why + "\n" + str.tostring(ret, "0.0") + " %", style=label.style_label_down, color=col, textcolor=color.white, size=size.small,
         tooltip="IZLAZ: " + why + ". Ulaz " + str.tostring(ePrice, "0.00") + ", izlaz " + str.tostring(xPrice, "0.00") + ". Rezultat trgovine nakon troškova: " + str.tostring(ret, "0.0") + " %.")

if showLegend and barstate.islast
    var table lg = table.new(position.top_right, 2, 15, border_width=1, frame_color=color.gray, frame_width=1)
    table.cell(lg, 0, 0, "Oznaka", text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small)
    table.cell(lg, 1, 0, "Što znači", text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small, text_halign=text.align_left)
    table.cell(lg, 0, 1, "zelena pozadina", bgcolor=color.new(color.green, 80), text_size=size.tiny)
    table.cell(lg, 1, 1, "Cijena iznad SMA 200: trend gore, smijemo kupovati", text_size=size.tiny, text_halign=text.align_left)
    table.cell(lg, 0, 2, "crvena pozadina", bgcolor=color.new(color.red, 80), text_size=size.tiny)
    table.cell(lg, 1, 2, "Cijena ispod SMA 200: trend dolje, ne kupujemo", text_size=size.tiny, text_halign=text.align_left)
    table.cell(lg, 0, 3, "narančasta linija", text_color=color.orange, text_size=size.tiny)
    table.cell(lg, 1, 3, "SMA 200: prosjek zadnjih 200 zatvaranja", text_size=size.tiny, text_halign=text.align_left)
    table.cell(lg, 0, 4, "zeleni krug", text_color=color.green, text_size=size.tiny)
    table.cell(lg, 1, 4, "Signal: pad ≥ 5 % u 5 dana uz trend gore", text_size=size.tiny, text_halign=text.align_left)
    table.cell(lg, 0, 5, "sivi križ", text_color=color.gray, text_size=size.tiny)
    table.cell(lg, 1, 5, "Pad ≥ 5 %, ali trend dolje: preskačemo", text_size=size.tiny, text_halign=text.align_left)
    table.cell(lg, 0, 6, "isprekidani okvir", text_color=color.green, text_size=size.tiny)
    table.cell(lg, 1, 6, "Jedna trgovina: zelen = dobitna, crven = gubitna", text_size=size.tiny, text_halign=text.align_left)
    table.cell(lg, 0, 7, "crvena linija", text_color=color.red, text_size=size.tiny)
    table.cell(lg, 1, 7, "Stop: 8 % ispod ulazne cijene", text_size=size.tiny, text_halign=text.align_left)
    table.cell(lg, 0, 8, "crna crta", text_color=color.black, text_size=size.tiny)
    table.cell(lg, 1, 8, "Ulazna cijena", text_size=size.tiny, text_halign=text.align_left)
    table.cell(lg, 0, 9, "plava strelica ↑ + tekst (npr. C13A +24)", text_color=color.blue, text_size=size.tiny)
    table.cell(lg, 1, 9, "TradingView: kupnja izvršena. Broj (+24) je broj kupljenih dionica", text_size=size.tiny, text_halign=text.align_left)
    table.cell(lg, 0, 10, "ljubičasta strelica ↓ + tekst (npr. -24 stop)", text_color=color.purple, text_size=size.tiny)
    table.cell(lg, 1, 10, "TradingView: prodaja izvršena. Broj je broj prodanih dionica, tekst je razlog izlaza", text_size=size.tiny, text_halign=text.align_left)
    table.cell(lg, 0, 11, "brojevi uz ime skripte (gore lijevo)", text_size=size.tiny)
    table.cell(lg, 1, 11, "Zadnje vrijednosti linija: SMA 200, klizeći stop, promjena u 5 dana, trend, dan u poziciji", text_size=size.tiny, text_halign=text.align_left)
    table.cell(lg, 0, 12, "točkasta crvena vodoravna crta", text_color=color.red, text_size=size.tiny)
    table.cell(lg, 1, 12, "TradingView: linija zadnje cijene (nije dio pravila)", text_size=size.tiny, text_halign=text.align_left)
    table.cell(lg, 0, 13, "isprekidana siva crta", text_color=color.gray, text_size=size.tiny)
    table.cell(lg, 1, 13, "TradingView: nišan miša (crosshair)", text_size=size.tiny, text_halign=text.align_left)
    table.cell(lg, 0, 14, "SAVJET", text_color=color.orange, text_size=size.tiny)
    table.cell(lg, 1, 14, "Na grafu drži samo jednu strategiju (A ili C), inače se oznake preklapaju", text_size=size.tiny, text_halign=text.align_left)

if showStatus and barstate.islast
    var table stt = table.new(position.bottom_right, 2, 6, border_width=1, frame_color=color.gray, frame_width=1)
    table.cell(stt, 0, 0, "Stanje na zadnjoj svijeći", text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small)
    table.cell(stt, 1, 0, "", bgcolor=color.new(color.gray, 20))
    table.cell(stt, 0, 1, "Trend", text_size=size.small)
    table.cell(stt, 1, 1, trendUp ? "gore (iznad SMA 200)" : "dolje (ispod SMA 200)", text_color=trendUp ? color.green : color.red, text_size=size.small)
    table.cell(stt, 0, 2, "Promjena u 5 dana", text_size=size.small)
    table.cell(stt, 1, 2, str.tostring(chg5 * 100, "0.0") + " %" + (dip ? " (pad ≥ 5 %)" : ""), text_size=size.small)
    table.cell(stt, 0, 3, "Pozicija", text_size=size.small)
    table.cell(stt, 1, 3, strategy.position_size > 0 ? "otvorena, dan " + str.tostring(bar_index - strategy.opentrades.entry_bar_index(0) + 1) + " od 10" : "nema", text_size=size.small)
    table.cell(stt, 0, 4, "Što radimo", text_size=size.small)
    table.cell(stt, 1, 4, strategy.position_size > 0 ? "držimo, stop " + str.tostring(strategy.position_avg_price * 0.92, "0.00") : (trendUp and dip ? "SIGNAL: sutra kupnja" : "čekamo signal"), text_size=size.small)
    table.cell(stt, 0, 5, "Okvir grafa", text_size=size.small)
    table.cell(stt, 1, 5, timeframe.isdaily ? "dnevni (D): ispravno" : "UPOZORENJE: pravilo vrijedi samo na dnevnom grafu (D)", text_color=timeframe.isdaily ? color.green : color.red, text_size=size.small)

if showGlossary and barstate.islast
    var table gl = table.new(position.bottom_left, 2, 13, border_width=1, frame_color=color.gray, frame_width=1)
    table.cell(gl, 0, 0, "Pojam", text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small)
    table.cell(gl, 1, 0, "Laički", text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small, text_halign=text.align_left)
    table.cell(gl, 0, 1, "SMA 200", text_size=size.tiny, text_halign=text.align_left)
    table.cell(gl, 1, 1, "Prosjek zadnjih 200 zatvaranja. Pokazuje dugoročni trend.", text_size=size.tiny, text_halign=text.align_left)
    table.cell(gl, 0, 2, "Trend gore / dolje", text_size=size.tiny, text_halign=text.align_left)
    table.cell(gl, 1, 2, "Zatvaranje iznad / ispod SMA 200.", text_size=size.tiny, text_halign=text.align_left)
    table.cell(gl, 0, 3, "Pad u trendu (pullback)", text_size=size.tiny, text_halign=text.align_left)
    table.cell(gl, 1, 3, "Kratak pad dok je veći trend još gore.", text_size=size.tiny, text_halign=text.align_left)
    table.cell(gl, 0, 4, "Signal", text_size=size.tiny, text_halign=text.align_left)
    table.cell(gl, 1, 4, "Trend gore + pad ≥ 5 % u 5 dana. Sutra se kupuje.", text_size=size.tiny, text_halign=text.align_left)
    table.cell(gl, 0, 5, "Stop", text_size=size.tiny, text_halign=text.align_left)
    table.cell(gl, 1, 5, "Unaprijed određena cijena izlaza koja ograničava gubitak.", text_size=size.tiny, text_halign=text.align_left)
    table.cell(gl, 0, 6, "Klizeći stop (trailing)", text_size=size.tiny, text_halign=text.align_left)
    table.cell(gl, 1, 6, "Stop koji prati najviši vrh i ide samo prema gore.", text_size=size.tiny, text_halign=text.align_left)
    table.cell(gl, 0, 7, "Gap", text_size=size.tiny, text_halign=text.align_left)
    table.cell(gl, 1, 7, "Razlika između jučerašnjeg zatvaranja i današnjeg otvaranja.", text_size=size.tiny, text_halign=text.align_left)
    table.cell(gl, 0, 8, "Drawdown (najveći pad)", text_size=size.tiny, text_halign=text.align_left)
    table.cell(gl, 1, 8, "Najveći pad računa od vrha do dna.", text_size=size.tiny, text_halign=text.align_left)
    table.cell(gl, 0, 9, "Profit factor", text_size=size.tiny, text_halign=text.align_left)
    table.cell(gl, 1, 9, "Ukupni dobici podijeljeni ukupnim gubicima. Iznad 1 = zarada.", text_size=size.tiny, text_halign=text.align_left)
    table.cell(gl, 0, 10, "Backtest", text_size=size.tiny, text_halign=text.align_left)
    table.cell(gl, 1, 10, "Simulacija pravila na prošlim podacima (s troškovima).", text_size=size.tiny, text_halign=text.align_left)
    table.cell(gl, 0, 11, "Swing", text_size=size.tiny, text_halign=text.align_left)
    table.cell(gl, 1, 11, "Držanje pozicije nekoliko dana do tjedana.", text_size=size.tiny, text_halign=text.align_left)
    table.cell(gl, 0, 12, "Dnevni graf (D)", text_size=size.tiny, text_halign=text.align_left)
    table.cell(gl, 1, 12, "Jedna svijeća = jedan dan. Pravilo vrijedi samo na njemu.", text_size=size.tiny, text_halign=text.align_left)
